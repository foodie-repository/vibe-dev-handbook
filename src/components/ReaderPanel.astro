---
interface Props { side: 'left' | 'right' }
const { side } = Astro.props;
const left = side === 'left';
const label = left ? '전체 목차' : '목차';
const linksId = left ? 'reader-sidebar-links' : 'reader-toc-links';
---

<reader-panel data-side={side} data-pagefind-ignore>
  {left && <strong class="sidebar-caption">{label}</strong>}
  <div id={linksId}><slot /></div>
  <button type="button" hidden aria-controls={linksId} aria-expanded="true" aria-label={label + ' 접기'} title={label + ' 접기'}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
  </button>
  <div class="panel-divider" role="separator" tabindex="0" hidden aria-label={label + ' 너비'} title={'드래그하거나 좌우 방향키로 ' + label + ' 너비 조절'} aria-orientation="vertical" aria-controls={linksId} aria-valuemin="180" aria-valuemax="360" aria-valuenow={left ? '300' : '256'}></div>
</reader-panel>

<script>
  class ReaderPanel extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>(':scope > button')!;
      const divider = this.querySelector<HTMLElement>('.panel-divider')!;
      const left = this.dataset.side === 'left';
      const label = left ? '전체 목차' : '목차';
      const direction = left ? 1 : -1;
      const sidebar = left ? document.documentElement : this.closest<HTMLElement>('.right-sidebar-container')!;
      const storageKey = left ? 'handbook.reader-sidebar' : 'handbook.reader-toc';
      const min = Number(divider.ariaValueMin);
      const max = Number(divider.ariaValueMax);
      let width = Number(divider.ariaValueNow);
      let collapsed = false;

      function setWidth(value: number) {
        width = Math.min(max, Math.max(min, Math.round(value)));
        sidebar.style.setProperty(left ? '--sidebar-open-width' : '--toc-open-width', width + 'px');
        divider.ariaValueNow = String(width);
        divider.ariaValueText = width + '픽셀';
      }
      function render() {
        sidebar.toggleAttribute(left ? 'data-sidebar-collapsed' : 'data-toc-collapsed', collapsed);
        divider.hidden = collapsed;
        button.ariaExpanded = String(!collapsed);
        button.ariaLabel = button.title = label + (collapsed ? ' 펼치기' : ' 접기');
      }
      function save() {
        try { localStorage.setItem(storageKey, JSON.stringify({ width, collapsed })); } catch { /* Storage is optional. */ }
      }
      try {
        const saved = JSON.parse(localStorage.getItem(storageKey) || 'null');
        if (Number.isFinite(saved?.width)) width = saved.width;
        collapsed = saved?.collapsed === true;
      } catch { /* Use defaults when storage is unavailable. */ }
      setWidth(width);
      render();
      button.hidden = false;
      button.onclick = () => {
        collapsed = !collapsed;
        render();
        save();
      };
      divider.onkeydown = (event) => {
        const values: Record<string, number> = { ArrowLeft: width - direction * 16, ArrowRight: width + direction * 16, Home: min, End: max };
        if (!(event.key in values)) return;
        event.preventDefault();
        setWidth(values[event.key]);
        save();
      };
      let startX = 0;
      let startWidth = width;
      divider.onpointerdown = (event) => {
        if (!event.isPrimary || event.button !== 0) return;
        startX = event.clientX;
        startWidth = width;
        divider.setPointerCapture(event.pointerId);
      };
      divider.onpointermove = (event) => {
        if (divider.hasPointerCapture(event.pointerId)) setWidth(startWidth + direction * (event.clientX - startX));
      };
      divider.onlostpointercapture = save;
    }
  }
  customElements.define('reader-panel', ReaderPanel);
</script>
