---
import TableOfContents from '@astrojs/starlight/components/TableOfContents.astro';
---

<reader-toc data-pagefind-ignore>
  <div id="reader-toc-links"><TableOfContents /></div>
  <button type="button" hidden aria-controls="reader-toc-links" aria-expanded="true" aria-label="목차 접기" title="목차 접기">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
  </button>
  <div class="toc-divider" role="separator" tabindex="0" hidden aria-label="목차 너비" title="드래그하거나 좌우 방향키로 목차 너비 조절" aria-orientation="vertical" aria-controls="reader-toc-links" aria-valuemin="180" aria-valuemax="360" aria-valuenow="256"></div>
</reader-toc>

<script>
  class ReaderToc extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button')!;
      const divider = this.querySelector<HTMLElement>('.toc-divider')!;
      const links = this.querySelector<HTMLElement>('#reader-toc-links')!;
      const sidebar = this.closest<HTMLElement>('.right-sidebar-container')!;
      const storageKey = 'handbook.reader-toc';
      const min = Number(divider.ariaValueMin);
      const max = Number(divider.ariaValueMax);
      let width = Number(divider.ariaValueNow);
      let collapsed = false;

      function setWidth(value: number) {
        width = Math.min(max, Math.max(min, Math.round(value)));
        sidebar.style.setProperty('--toc-open-width', width + 'px');
        divider.ariaValueNow = String(width);
        divider.ariaValueText = width + '픽셀';
      }
      function render() {
        sidebar.toggleAttribute('data-toc-collapsed', collapsed);
        links.hidden = divider.hidden = collapsed;
        button.ariaExpanded = String(!collapsed);
        button.ariaLabel = button.title = collapsed ? '목차 펼치기' : '목차 접기';
      }
      function save() {
        try { localStorage.setItem(storageKey, JSON.stringify({ width, collapsed })); } catch { /* Storage is optional. */ }
      }
      try {
        const saved = JSON.parse(localStorage.getItem(storageKey) || 'null');
        if (Number.isFinite(saved?.width)) width = saved.width;
        collapsed = saved?.collapsed === true;
      } catch { /* Use defaults when storage is unavailable. */ }
      setWidth(width);
      render();
      button.hidden = false;
      button.onclick = () => {
        collapsed = !collapsed;
        render();
        save();
      };
      divider.onkeydown = (event) => {
        const values: Record<string, number> = { ArrowLeft: width + 16, ArrowRight: width - 16, Home: min, End: max };
        if (!(event.key in values)) return;
        event.preventDefault();
        setWidth(values[event.key]);
        save();
      };
      let startX = 0;
      let startWidth = width;
      divider.onpointerdown = (event) => {
        if (!event.isPrimary || event.button !== 0) return;
        startX = event.clientX;
        startWidth = width;
        divider.setPointerCapture(event.pointerId);
      };
      divider.onpointermove = (event) => {
        if (divider.hasPointerCapture(event.pointerId)) setWidth(startWidth + startX - event.clientX);
      };
      divider.onlostpointercapture = save;
    }
  }
  customElements.define('reader-toc', ReaderToc);
</script>
